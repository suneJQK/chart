{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "app.py": {
      "runtime": "python3.12"
    }
  },
  "routes": [
    {
      "src": "/api/ai-chat",
      "dest": "/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "/app.py"
    }
  ]
}